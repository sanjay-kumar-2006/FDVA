import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

url = "https://raw.githubusercontent.com/mwaskom/seaborn-data/master/titanic.csv"

df = pd.read_csv(url)

print("Dataset loaded successfully!")
display(df.head())

df.info()

print("Dataset Shape:", df.shape)

display(df.describe())

df['age'] = df['age'].fillna(df['age'].median())
df['embarked'] = df['embarked'].fillna(df['embarked'].mode()[0])

print("Missing values after cleaning:")
print(df.isnull().sum())

print("Total Passengers:", len(df))
print("Number of Passengers Survived:", df['survived'].sum())
print("Survival Rate:", round(df['survived'].mean() * 100, 2), "%")
print("Average Age:", round(df['age'].mean(), 2))
print("Average Fare:", round(df['fare'].mean(), 2))

plt.figure(figsize=(7, 5))
sns.countplot(data=df, x='survived')
plt.title('Titanic Survival Count')
plt.xlabel('Survived (0 = No, 1 = Yes)')
plt.ylabel('Number of Passengers')
plt.show()

plt.figure(figsize=(7, 5))
sns.countplot(data=df, x='sex', hue='survived')
plt.title('Survival by Gender')
plt.xlabel('Gender')
plt.ylabel('Number of Passengers')
plt.show()

plt.figure(figsize=(7, 5))
sns.countplot(data=df, x='class', hue='survived')
plt.title('Survival by Passenger Class')
plt.xlabel('Passenger Class')
plt.ylabel('Number of Passengers')
plt.show()

plt.figure(figsize=(8, 5))
sns.histplot(df['age'], bins=20, kde=True)
plt.title('Age Distribution of Titanic Passengers')
plt.xlabel('Age')
plt.ylabel('Number of Passengers')
plt.show()

df.to_excel('titanic_cleaned.xlsx', index=False)

print("Cleaned dataset exported successfully as titanic_cleaned.xlsx")
